<% if Setting.plugin_redmine_omniauth_gitlab.with_indifferent_access[:oauth_authentification] %>
  <%= stylesheet_link_tag 'buttons', :plugin => 'redmine_omniauth_gitlab' %>
  <div class="gitlab-login">
    <%= link_to oauth_gitlab_path(:back_url => back_url), :class => 'gitlab-login-button' do %>
      <%= image_tag 'gitlab_login_icon.png', :plugin => 'redmine_omniauth_gitlab', :class => 'gitlab-login-icon', :alt => '', :width => 20, :height => 20 %>
      <span><%= l(:login_via_gitlab) %></span>
    <% end %>
  </div>
<% end %>
